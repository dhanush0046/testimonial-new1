// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CollectionType {
  TEXT_ONLY
  VIDEO_ONLY
  TEXT_AND_VIDEO
}

enum Theme {
  LIGHT
  DARK
}

enum TestimonialType {
  TEXT
  VIDEO
}

enum Language {
  ENGLISH
  SPANISH
  FRENCH
  GERMAN
  CHINESE
}

model Space {
  id                    String     @id @default(uuid())
  spaceName             String
  headerTitle           String
  customMessage         String
  logo                  String?
  logoShape             Boolean    @default(false)
  shareableLink         String?
  collectionType        CollectionType
  collectStarRatings    Boolean    @default(false)
  theme                 Theme      @default(LIGHT)
  autoTranslate         Boolean    @default(false)
  language              Language   @default(ENGLISH)
  questions              Json      @default("[]")
  extraInformationFields Json      @default("[]")
  testimonials          Testimonial[]
  apiKey                ApiKey[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  // Thank you page fields
  thankYouImage         String?
  hideImage             Boolean    @default(false)
  thankYouTitle         String     @default("Thank you!")
  thankYouMessage       String     @default("Thank you so much for your shoutout! It means a ton for us! 🙏")
  allowSocialShare      Boolean    @default(false)
  redirectUrl           String?
  autoReward            Boolean    @default(false)

    // Extra settings
  maxVideoDuration        Int       @default(120)
  maxTextCharacters       Int       @default(0)
  videoButtonText         String    @default("Record a video")
  textButtonText          String    @default("Send in text")
  consentDisplay          String    @default("required")
  consentStatement        String    @default("I give permission to use this testimonial.")
  textSubmissionTitle     String    @default("Title")
  videoSubmissionTitle    String    @default("Title")
  questionLabel           String    @default("Questions")
  affiliateLink           String?
  thirdPartyReviewPlatform String?
  thirdPartyReviewLink    String?
  autoPopulateWallOfLove  Boolean   @default(false)
  disableVideoForIphone   Boolean   @default(false)
  allowSearchEngineIndexing Boolean @default(false)
  customButtonColorRV     String     @default("#4F46E5")
  customButtonColorST     String     @default("#6B7280")
  openGraphTitle          String?
  openGraphDescription    String?
  openGraphImage          String?

  tagsDisplayOnWall Boolean  @default(true)
  tags              Tag[]

  wallOfLoveSettings    WallOfLoveSettings?
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  space     Space    @relation(fields: [spaceId], references: [id])
  spaceId   String
  createdAt DateTime @default(now())
}

model Tag {
  id            String   @id @default(uuid())
  name          String
  displayOnWall Boolean @default(false)
  isActive      Boolean @default(true)
  position      Int
  spaceId       String
  space         Space    @relation(fields: [spaceId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([spaceId, name])
  @@index([spaceId])
}

// New model for Wall of Love settings
model WallOfLoveSettings {
  id                    String     @id @default(uuid())
  spaceId               String     @unique
  space                 Space      @relation(fields: [spaceId], references: [id])

  coverImage            String?
  coverImageDarkness    Int        @default(100)
  topBannerText         String     @default("Wall of Love")
  topBannerTextColor    String     @default("#FFFFFF")
  topBannerButtonText   String     @default("Submit your testimonial")
  topBannerButtonColor  String     @default("#4F46E5")
  showBorder            Boolean    @default(false)
  borderRadius          String     @default("small")
  borderColor           String     @default("#E5E7EB")
  borderThickness       Int        @default(1)

  // Additional customization fields
  // showShadow            Boolean    @default(false)
  // shadowColor           String     @default("rgba(0, 0, 0, 0.1)")
  // backgroundColor       String     @default("#FFFFFF")
  // textColor             String     @default("#000000")
  // fontFamily            String     @default("Inter, sans-serif")
  // testimonialLayout     String     @default("grid")
  // testimonialSpacing    Int        @default(16)

  // // Video settings
  // showVideoThumbnail    Boolean    @default(true)
  // videoPlayerTheme      String     @default("light")

  // // Tag settings
  // showTags              Boolean    @default(true)
  // tagStyle              String     @default("pill")
  // tagColor              String     @default("#E5E7EB")
  // tagTextColor          String     @default("#4B5563")

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model Testimonial {
  id                String   @id @default(cuid())
  spaceId           String
  content           String
  type              TestimonialType
  rating            Int?
  photo             String?
  videoUrl          String?
  videoThumbnail    String?
  attachedImages    String[] // New field for attached images
  permissionGranted Boolean  @default(false)
  extraInformation  Json     @default("[]")
  companyLink       String?
  companyLogo       String?
  readMoreLink      String?
  excerpt           String?
  internalComments  String?
  isLiked           Boolean @default(false)
  isHighlighted     Boolean  @default(false)
  isArchived        Boolean @default(false)
  isSpam            Boolean @default(false)
  tags              String[] 
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  space             Space    @relation(fields: [spaceId], references: [id])
}
